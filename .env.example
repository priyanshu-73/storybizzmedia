# Copy to .env.local and fill in. Next.js reads .env.local for `npm run dev`,
# and docker-compose.yml loads the same file into the container via env_file.

# Required for The Draft (/api/draft). Without it the route answers 503 and the
# form shows "The Draft isn't switched on yet."
ANTHROPIC_API_KEY=

# Optional model overrides. Leave unset to use the defaults in app/api/draft/route.ts
# (claude-haiku-4-5 for the gatekeeper, claude-sonnet-5 for the newsroom).
DRAFT_GATEKEEPER_MODEL=
DRAFT_NEWSROOM_MODEL=

# Leads endpoint on Internal Asset Hub that the PR recommendation form (PrModal)
# and The Draft's unlock gate submit to. NEXT_PUBLIC_* is inlined at build time,
# so changing this for the Docker image means passing it as a build arg, not a
# runtime env var. Unset falls back to https://one.storybizz.in/api/landing/leads
NEXT_PUBLIC_LEADS_API_URL=
